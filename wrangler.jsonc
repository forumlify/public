{
	"main": ".open-next/worker.js",
	"name": "forumlify",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "forumlify"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}
